<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="holder_18650_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>18650 holder with protected cell</title>
    <label>P</label>
    <date>2026-09-07</date>
    <tags><tag>mouse</tag></tags>
    <properties><property name="family">18650 holder with protected cell</property></properties>
    <description>18650 spring holder sized for a protected NCR18650B (~68 mm). Red (+) and black (-) leads exit on the left.</description>
    <views>
        <iconView><layers image="icon/holder_18650_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/holder_18650_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/holder_18650_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/holder_18650_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector0" type="male" name="+">
            <description>+</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector1" type="male" name="-">
            <description>-</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
