# Generated outputs (Phase E build pipeline)
# These are regenerated from source .md files — do not commit.
# Use the `/*` form (not the directory form) so that re-inclusion negations below
# actually take effect — git can't re-include files under an ignored directory.
build_output/*

# Exception: commit the cards-only bundle so it can be shared without a rebuild.
!build_output/Project_1_Cards*.html
!build_output/Project_1_Cards*.pdf
!build_output/Project_2_Cards*.html
!build_output/Project_2_Cards*.pdf
!build_output/Project_3_Cards*.html
!build_output/Project_3_Cards*.pdf
!build_output/Project_4_Cards*.html
!build_output/Project_4_Cards*.pdf
!build_output/Project_5_Cards*.html
!build_output/Project_5_Cards*.pdf
!build_output/Project_6_Cards*.html
!build_output/Project_6_Cards*.pdf
!build_output/Project_7_Cards*.html
!build_output/Project_7_Cards*.pdf
!build_output/Project_8_Cards*.html
!build_output/Project_8_Cards*.pdf

# Node modules (if md-to-pdf is installed locally)
node_modules/
package-lock.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Runtime lock files
.claude/scheduled_tasks.lock

# _fritzing_kit intermediates (regenerable by build_figure.js)
**/images/fritzing/*.pins.json
**/images/fritzing/*.spec.tmp.json
**/images/fritzing/*_preview.png
**/images/fritzing/_export_*/

# Blender working renders (the published SVGs live under each project's images/)
_blender/work/

__pycache__/
*.pyc

# Staging area for files on their way out — 1.1 GB of old renders, previous
# build_output copies and zips. Never commit this.
_to_delete/

# Silkscreen textures are a CACHE: pcb.py regenerates them with PIL on every run
# (Silk.save writes unconditionally), same class as _blender/work/.
_blender/textures/

# build_overview_with_cards.js intermediates
*.part1.md
*.part2.md
*.part1.pdf
*.part2.pdf

# generated student website (rebuild with: node build_site.js)
site/
.vendor-cache/

# poster build: per-poster PNGs are regenerable from src/ (node Arduino_Projects/_posters/build_posters.js)
Arduino_Projects/_posters/out/poster_p*.png
Arduino_Projects/_posters/out/_tmp*
