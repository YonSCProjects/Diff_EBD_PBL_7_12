<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="8xAA_box_yon_2026">
    <author>Yon (derived from Adafruit 4xAA Switchable Battery Pack by John De Cristofaro)</author>
    <title>8 x AA Battery Box (12V) with switch</title>
    <label>BATT</label>
    <date>2026-08-21</date>
    <tags><tag>battery</tag><tag>AA</tag><tag>12V</tag><tag>power</tag></tags>
    <properties>
        <property name="family">Battery</property>
        <property name="voltage">12V</property>
    </properties>
    <description>Closed 8 x AA battery box with ON/OFF switch and two bare leads (red +, black -).</description>
    <views>
        <iconView><layers image="icon/8xAA_box_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/8xAA_box_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/8xAA_box_pcb.svg"><layer layerId="copper0"/><layer layerId="silkscreen"/><layer layerId="copper1"/></layers></pcbView>
        <breadboardView><layers image="breadboard/8xAA_box_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector1" type="male" name="+">
            <description>positive lead (red)</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper1" svgId="connector1pin"/><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector2" type="male" name="-">
            <description>negative lead (black)</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector2pin"/></schematicView>
                <pcbView><p layer="copper1" svgId="connector2pin"/><p layer="copper0" svgId="connector2pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
