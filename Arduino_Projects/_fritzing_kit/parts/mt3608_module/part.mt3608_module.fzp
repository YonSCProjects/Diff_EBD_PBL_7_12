<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="mt3608_module_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>MT3608 step-up module</title>
    <label>P</label>
    <date>2026-08-22</date>
    <tags><tag>quadcopter</tag></tags>
    <properties><property name="family">MT3608 step-up module</property></properties>
    <description>MT3608 2 A boost converter module: IN+ / IN- pads on the left, OUT+ / OUT- on the right, trimmer to set the output.</description>
    <views>
        <iconView><layers image="icon/mt3608_module_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/mt3608_module_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/mt3608_module_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/mt3608_module_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector0" type="male" name="Vin">
            <description>Vin</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector1" type="male" name="GND">
            <description>GND</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector2" type="male" name="Vout">
            <description>Vout</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector2pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector2pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector3" type="male" name="GND*">
            <description>GND*</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector3pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector3pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
