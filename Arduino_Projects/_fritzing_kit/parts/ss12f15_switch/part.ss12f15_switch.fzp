<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="ss12f15_switch_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>SS12F15 slide switch</title>
    <label>P</label>
    <date>2026-09-07</date>
    <tags><tag>mouse</tag></tags>
    <properties><property name="family">SS12F15 slide switch</property></properties>
    <description>SS12F15 slide switch: COM in the middle, positions 1 and 2. Used as the mouse main power switch.</description>
    <views>
        <iconView><layers image="icon/ss12f15_switch_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/ss12f15_switch_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/ss12f15_switch_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/ss12f15_switch_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector0" type="male" name="1">
            <description>1</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector1" type="male" name="COM">
            <description>COM</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector2" type="male" name="2">
            <description>2</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector2pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector2pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
