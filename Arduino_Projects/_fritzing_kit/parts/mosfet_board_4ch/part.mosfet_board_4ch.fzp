<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="mosfet_board_4ch_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>4-channel MOSFET motor board (IRLB8721, perfboard)</title>
    <label>P</label>
    <date>2026-08-22</date>
    <tags><tag>quadcopter</tag></tags>
    <properties><property name="family">4-channel MOSFET motor board (IRLB8721, perfboard)</property></properties>
    <description>Hand-soldered perfboard with four IRLB8721 low-side switches, flyback Schottky diodes, 100 ohm gate resistors, 10k pull-downs and a bulk capacitor; pads BAT+, GND, M1..M4 +/-, G1..G4.</description>
    <views>
        <iconView><layers image="icon/mosfet_board_4ch_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/mosfet_board_4ch_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/mosfet_board_4ch_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/mosfet_board_4ch_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
