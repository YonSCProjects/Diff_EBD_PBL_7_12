<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="gm80_switch_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>Kailh GM 8.0 mouse switch</title>
    <label>P</label>
    <date>2026-09-07</date>
    <tags><tag>mouse</tag></tags>
    <properties><property name="family">Kailh GM 8.0 mouse switch</property></properties>
    <description>Kailh GM 8.0 mouse microswitch (clicky). Two wired legs: COM and NO, drawn as 1 and 2.</description>
    <views>
        <iconView><layers image="icon/gm80_switch_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/gm80_switch_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/gm80_switch_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/gm80_switch_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector0" type="male" name="1">
            <description>1</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector1" type="male" name="2">
            <description>2</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
