<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="motor_8520_ccw_yon_2026">
    <author>Yon (drawn for the Arduino PBL program, 2026)</author>
    <title>8520 coreless motor (CCW, white/black leads)</title>
    <label>P</label>
    <date>2026-08-22</date>
    <tags><tag>quadcopter</tag></tags>
    <properties><property name="family">8520 coreless motor (CCW, white/black leads)</property></properties>
    <description>8.5 x 20 mm coreless brushed motor, counter-clockwise type: white (+) and black (-) leads.</description>
    <views>
        <iconView><layers image="icon/motor_8520_ccw_icon.svg"><layer layerId="icon"/></layers></iconView>
        <schematicView><layers image="schematic/motor_8520_ccw_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
        <pcbView><layers image="pcb/motor_8520_ccw_pcb.svg"><layer layerId="copper0"/></layers></pcbView>
        <breadboardView><layers image="breadboard/motor_8520_ccw_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    </views>
    <connectors>
        <connector id="connector0" type="male" name="+">
            <description>+</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
            </views>
        </connector>
        <connector id="connector1" type="male" name="-">
            <description>-</description>
            <views>
                <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
                <schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
                <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
            </views>
        </connector>
    </connectors>
</module>
